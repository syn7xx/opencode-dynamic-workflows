{
  "name": "@syn7xx/opencode-dynamic-workflows",
  "version": "0.3.0",
  "description": "Deterministic multi-agent Workflows for OpenCode: TypeScript scripts that fan work out to subagents, with typed results, a live TUI panel, a web app and a versioned protocol.",
  "keywords": [
    "agents",
    "llm",
    "multi-agent",
    "opencode",
    "opencode-plugin",
    "orchestration",
    "subagents",
    "tui",
    "workflow"
  ],
  "homepage": "https://github.com/syn7xx/opencode-dynamic-workflows#readme",
  "bugs": "https://github.com/syn7xx/opencode-dynamic-workflows/issues",
  "license": "MIT",
  "author": "syn7xx (https://github.com/syn7xx)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syn7xx/opencode-dynamic-workflows.git",
    "directory": "packages/plugin"
  },
  "files": [
    "server.ts",
    "rpc.ts",
    "tui.js",
    "skill",
    "src",
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/index.ts",
    "./workflow": "./src/workflow/index.ts",
    "./protocol": "./src/protocol/index.ts",
    "./rpc": "./src/service/rpc.ts",
    "./tui": "./dist/tui.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opencode/plugin": "^2.1.3",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@opencode/client": "2.1.3",
    "@opencode/theme": "2.1.3",
    "@opentui/core": "0.6.6",
    "@opentui/solid": "0.6.6",
    "solid-js": "1.9.12"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  }
}
